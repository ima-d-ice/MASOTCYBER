# Copy to .env and fill in. Never commit .env.
# Up to 20 rotating keys are supported (GROQ_API_KEY_1.._20, plus GROQ_API_KEY).
GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GROQ_API_KEY=

# Model overrides (defaults in groq_client.py MODEL_REGISTRY)
# LLM_MODEL=llama-3.3-70b-versatile
# ORCHESTRATOR_MODEL=openai/gpt-oss-120b
# ORCHESTRATOR_FALLBACK_MODEL=llama-3.3-70b-versatile
# INVESTIGATOR_MODEL=qwen/qwen3.6-27b
# INVESTIGATOR_FALLBACK_MODEL=openai/gpt-oss-20b
# INVESTIGATOR_TERTIARY_MODEL=openai/gpt-oss-safeguard-20b

# Gate tuning (defaults in main.py)
# MAX_WINDOWS=5000
# START_WINDOW=0
# GATE_PERSISTENCE=2
# GATE_SEVERITY_MULT=1.0
# GATE_RECHECK=none
